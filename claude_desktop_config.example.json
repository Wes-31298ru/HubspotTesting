{
  "mcpServers": {
    "hubspot": {
      "command": "npx",
      "args": ["-y", "@hubspot/mcp-server@0.4.0"],
      "env": {
        "HUBSPOT_ACCESS_TOKEN": "your-hubspot-token-here"
      }
    },
    "aws-serverless": {
      "command": "npx",
      "args": ["-y", "@awslabs/aws-serverless-mcp-server"],
      "env": {
        "AWS_PROFILE": "default",
        "AWS_REGION": "us-east-1"
      }
    }
  }
}
